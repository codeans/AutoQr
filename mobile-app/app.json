{
  "expo": {
    "name": "AutoQr",
    "slug": "autoqr",
    "scheme": "autoqr",
    "owner": "codeans",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "description": "AutoQr is a secure QR-based vehicle communication platform that allows people to contact vehicle owners privately after an incident without exposing personal contact details.",
    "primaryColor": "#1D4ED8",
    "icon": "./assets/icons/icon.png",
    "splash": {
      "image": "./assets/splash/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "assets/icons/**",
      "assets/splash/**",
      "assets/branding/**",
      "assets/sounds/**"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.autoqr.app",
      "buildNumber": "1",
      "icon": "./assets/icons/ios-icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "AutoQr Germany",
        "NSMicrophoneUsageDescription": "AutoQr needs microphone access so you can speak with the person who scanned your vehicle's QR.",
        "NSCameraUsageDescription": "AutoQr needs camera access to capture vehicle plate photos.",
        "NSPhotoLibraryUsageDescription": "AutoQr needs photo library access to attach vehicle plate photos.",
        "UIBackgroundModes": [
          "voip",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "de.autoqr.app",
      "versionCode": 1,
      "icon": "./assets/icons/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#1D4ED8"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "name": "AutoQr",
      "shortName": "AutoQr",
      "description": "Secure Vehicle Contact QR",
      "backgroundColor": "#FFFFFF",
      "themeColor": "#1D4ED8",
      "favicon": "./assets/icons/favicon-96.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification-icon.png",
          "color": "#1D4ED8",
          "sounds": [
            "./assets/sounds/autoqr_ringtone.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AutoQr accesses your photos to attach vehicle images."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AutoQr needs camera access to capture incident evidence.",
          "microphonePermission": "AutoQr needs microphone access for secure incident calling.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AutoQr accesses your photos to attach vehicle and incident images.",
          "savePhotosPermission": "AutoQr can save evidence images when you export a report."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://api.autoqr.de/api",
      "socketUrl": "https://api.autoqr.de",
      "assetsBaseUrl": "https://api.autoqr.de",
      "brand": {
        "name": "AutoQr",
        "shortName": "AutoQr",
        "displayName": "AutoQr Germany",
        "tagline": "Secure Vehicle Contact QR",
        "keywords": [
          "AutoQr",
          "Vehicle QR",
          "Car Protection",
          "Germany Vehicle Safety",
          "Incident Contact",
          "Car Owner QR",
          "Smart Vehicle Contact",
          "AutoQr",
          "Vehicle QR",
          "Car Protection",
          "Germany Vehicle Safety",
          "Incident Contact",
          "Car Owner QR",
          "Smart Vehicle Contact"
        ],
        "colors": {
          "primary": "#1D4ED8",
          "surface": "#FFFFFF",
          "onSurface": "#111827"
        }
      },
      "router": {},
      "eas": {
        "projectId": "0735c5f5-493e-4d55-83e4-1404ed88b964"
      }
    }
  }
}
