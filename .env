# =============================================================================
# AutoQR — Production environment
# =============================================================================
# Live server IP: 45.132.241.96
# Dedicated ports chosen so AutoQR stays isolated from other services on the
# same host:
#   - frontend (nginx static SPA)  : host port 8180  -> container 80
#   - backend  (node api + socket) : host port 8181  -> container 4000
# If you put a real domain / TLS reverse-proxy in front of this, override
# CLIENT_URL / PUBLIC_BASE_URL / VITE_* to use that domain instead.
# =============================================================================

# ---- Host ports (used by docker-compose.prod.yml) ----
AUTOQR_FRONTEND_PORT=8180
AUTOQR_BACKEND_PORT=8181

# ---- Database (external MongoDB — no mongodb container is started) ----
MONGODB_URI=mongodb://root:C0d3%40n%24%402026@45.132.241.96:32768/autoqr?authSource=admin

# ---- JWT / session secrets (MUST be replaced — minimum 16 chars each) ----
JWT_ACCESS_SECRET=3IFV5bycExZ2eeo54mFh813K0MZMLKynOBnFGLzVxDA=
JWT_REFRESH_SECRET=jtdQs/nxXe0hTOpMf07kp4H5XnvJdOj8jmbTy9G3dZY=

# ---- Public URLs that the backend embeds in tokens / links ----
CLIENT_URL=http://45.132.241.96:8180
PUBLIC_BASE_URL=http://45.132.241.96:8180
CORS_ORIGINS=http://45.132.241.96:8180,http://45.132.241.96

# ---- Stripe (optional — leave blank to disable checkout) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EUR_CENTS=4900

# ---- Notification providers (abstracted — swap implementations in infrastructure/notifications) ----
SMS_PROVIDER=
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_PROVIDER_KEY=
EMAIL_PROVIDER=
EMAIL_FROM=no-reply@autoqr.example
PUSH_PROVIDER=

# ---- Telephony / masked call relay ----
TELEPHONY_PROVIDER=local-webrtc
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_MASK_NUMBER=

# ---- Frontend build-time config (consumed by apps/web at docker build) ----
VITE_API_URL=http://45.132.241.96:8181/api
VITE_SOCKET_URL=http://45.132.241.96:8181
VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
