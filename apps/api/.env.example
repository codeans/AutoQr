NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://db_user:db_password@your-cluster.mongodb.net/autoqr?retryWrites=true&w=majority
CLIENT_URL=https://autoqr.de
CORS_ORIGINS=https://autoqr.de,https://www.autoqr.de
TRUST_PROXY=true
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_value
JWT_REFRESH_SECRET=replace_with_a_second_long_random_secret_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOG_LEVEL=info

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EUR_CENTS=4900
PUBLIC_BASE_URL=https://autoqr.de

UPLOAD_DIR=/app/uploads
UPLOAD_MAX_MB=8
BODY_LIMIT_MB=2
DB_CONNECT_TIMEOUT_MS=10000
DB_MAX_RETRIES=8
DB_RETRY_DELAY_MS=2000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_PING_INTERVAL_MS=25000

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=AutoQr Admin
ADMIN_PHONE=+491111111111
ADMIN_ADDRESS=Berlin, Germany
